{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "room",
    "start",
    "end",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "owner": {
      "type": "string",
      "enum": [
        "alice",
        "bob"
      ]
    },
    "room": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled"
      ]
    }
  }
}
